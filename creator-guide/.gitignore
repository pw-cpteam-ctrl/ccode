# creator-guide 폴더 전용 규칙.
#
# 최상단(ccode/.gitignore)이 아니라 여기에 두는 이유: 이 폴더는 언젠가 다른
# 저장소로 통째로 옮겨질 수 있다. 규칙이 최상단에만 있으면 옮기는 순간 빠져서,
# 빌드 결과물이 저장소에 딸려 올라간다. 폴더와 같이 다니게 둔다.

# 접속 코드로 잠근 가이드 본문. 배포할 때마다 새로 만든다(build-lock.js).
# 저장소에 두면 잠금이 풀린 시점의 낡은 사본이 남을 뿐이라 커밋하지 않는다.
locked/

# 실제로 배포되는 폴더. build-lock.js가 매 배포마다 새로 만든다.
dist/

# 원본에서 다시 만들 수 있는 파생물.
standalone/
node_modules/

# 브라우저 검증용으로 받아둔 외부 라이브러리 사본.
.vendor-cache/
