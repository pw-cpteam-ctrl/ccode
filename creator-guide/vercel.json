{
  "buildCommand": "node build-lock.js",
  "outputDirectory": "dist",
  "ignoreCommand": "[ -z \"$VERCEL_GIT_PREVIOUS_SHA\" ] && exit 1; git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA\" 2>/dev/null || exit 1; git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD ./",
  "redirects": [
    { "source": "/reward-view-admin", "destination": "https://influencer-board-bice.vercel.app/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/gsbs", "destination": "/brand2.html" }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "functions": {
    "api/chat.js": {
      "includeFiles": "knowledge-*.md"
    }
  }
}
